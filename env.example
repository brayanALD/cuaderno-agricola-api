# Copia este archivo a .env.local (NO se versiona). Aquí van SOLO valores falsos.
# Desarrollo local: Firebase Emulator Suite, sin secretos reales en disco.
# Producción: estas variables viven ÚNICAMENTE en Vercel. `vercel env pull` está prohibido.
FIREBASE_PROJECT_ID=demo-cuaderno-agricola
FIREBASE_CLIENT_EMAIL=cuenta-falsa@demo-cuaderno-agricola.invalid
# En Vercel se pega con \n literales y se convierte a saltos de línea al iniciar.
FIREBASE_PRIVATE_KEY=valor-falso-con-\n-literales
FIREBASE_WEB_API_KEY=clave-web-falsa
BLOB_READ_WRITE_TOKEN=token-blob-falso
# Solo desarrollo: apuntan al emulador, nunca a producción.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

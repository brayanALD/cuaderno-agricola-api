{
  "name": "37-cuaderno-agricola-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cuaderno de campo agrícola: API (Next.js Route Handlers + Firebase Admin + Vercel Blob).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:hooks": "node --test .claude/hooks/guard.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:hooks"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
